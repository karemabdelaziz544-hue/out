# ==============================================================================
# OUT Platform — Isolated Test Project Credentials (NEVER USE PRODUCTION KEYS!)
# ==============================================================================
# Copy this file to `.env.test.local` (which is gitignored) and fill in the
# credentials from your SEPARATE EMPTY Supabase Test Project ONLY.
# `scripts/test-rls-real-session.ts` refuses to run if TEST_SUPABASE_URL matches
# `.env.local` NEXT_PUBLIC_SUPABASE_URL.
# ==============================================================================

TEST_SUPABASE_URL=https://YOUR_EMPTY_TEST_PROJECT_REF.supabase.co
TEST_SUPABASE_ANON_KEY=YOUR_TEST_PROJECT_ANON_KEY
TEST_SUPABASE_SERVICE_ROLE_KEY=YOUR_TEST_PROJECT_SERVICE_ROLE_KEY
